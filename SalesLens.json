{
  "name": "SalesLens",
  "dataColors": ["#2563EB", "#1D4ED8", "#F59E0B", "#60A5FA", "#94A3B8", "#0F172A", "#93C5FD", "#CBD5E1"],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#2563EB",
  "good": "#16A34A",
  "neutral": "#F59E0B",
  "bad": "#DC2626",
  "maximum": "#1D4ED8",
  "center": "#93C5FD",
  "minimum": "#DBEAFE",
  "null": "#CBD5E1",
  "textClasses": {
    "callout": { "fontSize": 24, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#6B7280" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E9F0" } }, "radius": 8 }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#1F2937" } },
          "fontSize": 12,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6FA" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{
          "fontSize": 24,
          "fontFamily": "Segoe UI Semibold",
          "color": { "solid": { "color": "#1F2937" } }
        }],
        "categoryLabels": [{
          "show": true,
          "fontSize": 10,
          "color": { "solid": { "color": "#6B7280" } }
        }]
      }
    }
  }
}